local HttpService = game:GetService("HttpService")

local function persistenceAvailable()
    return type(readfile) == "function"
        and type(writefile) == "function"
        and type(isfile) == "function"
end

local function savePersistentData()
    if not persistenceAvailable() then
        return false
    end

    local payload = {
        CurrentConfig = currentConfig,
        AutoLoad = autoLoad,
        Configs = configs,
    }

    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(payload)
    end)

    if not ok then
        return false
    end

    local success = pcall(function()
        writefile(configFile, encoded)
    end)

    return success
end

local function loadPersistentData()
    if not persistenceAvailable() then
        return false
    end

    if not isfile(configFile) then
        return false
    end

    local ok, raw = pcall(function()
        return readfile(configFile)
    end)

    if not ok or type(raw) ~= "string" or raw == "" then
        return false
    end

    local decodeOk, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)

    if not decodeOk or type(data) ~= "table" then
        return false
    end

    autoLoad = data.AutoLoad ~= false

    if type(data.CurrentConfig) == "number" then
        currentConfig = math.clamp(math.floor(data.CurrentConfig), 1, 3)
    end

    if type(data.Configs) == "table" then
        for i = 1, 3 do
            local slot = data.Configs[tostring(i)] or data.Configs[i]

            if type(slot) == "table" then
                configs[i] = slot
            end
        end
    end

    return true
end

local function cloneSettings(source)
    local copy = {}
    for k, v in pairs(source) do
        copy[k] = v
    end
    return copy
end

local function resetSettings()
    settings = cloneSettings(defaults)
end

local function saveConfig(slot)
    slot = math.clamp(math.floor(tonumber(slot) or 1), 1, 3)
    configs[slot] = cloneSettings(settings)
    currentConfig = slot
    savePersistentData()
end

local function loadConfig(slot)
    slot = math.clamp(math.floor(tonumber(slot) or 1), 1, 3)

    if configs[slot] then
        settings = cloneSettings(configs[slot])
        currentConfig = slot
        savePersistentData()
        return true
    end

    return false
end

local function autoLoadSelectedConfig()
    if not autoLoad then
        return false
    end

    return loadConfig(currentConfig)
end

loadPersistentData()
autoLoadSelectedConfig()


