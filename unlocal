local function refreshConfigSlots()
    for i = 1, 3 do
        if configs[i] then
            slotButtons[i].Text = "CONFIG " .. i .. "\nSAVED"
            slotButtons[i].TextColor3 = Theme.Success
        else
            slotButtons[i].Text = "CONFIG " .. i .. "\nEMPTY"
            slotButtons[i].TextColor3 = Theme.Muted
        end

        if currentConfig == i then
            slotButtons[i].BackgroundColor3 = Theme.AccentDark
        else
            slotButtons[i].BackgroundColor3 = Theme.Element
        end
    end
end

