    knob.BorderSizePixel = 0
    knob.ZIndex = 15
    knob.Parent = toggle
    addCorner(knob, 15)

    local function refresh()
        local enabled = getter()

        if enabled then
            tween(toggle, tweenFast, {
                BackgroundColor3 = Theme.AccentDark
            }):Play()

            tween(knob, tweenFast, {
                Position = UDim2.new(1, -26, 0, 4),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            }):Play()
        else
            tween(toggle, tweenFast, {
                BackgroundColor3 = Color3.fromRGB(41, 45, 55)
            }):Play()

            tween(knob, tweenFast, {
                Position = UDim2.fromOffset(4, 4),
                BackgroundColor3 = Color3.fromRGB(190, 194, 202)
            }):Play()
        end
    end

    toggle.MouseButton1Click:Connect(function()
        setter(not getter())
        refresh()
    end)

    refresh()
    return refresh
end


local function makeSlider(page, labelText, description, minValue, maxValue, getter, setter, decimals, suffix)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -4, 0, 76)
    holder.BackgroundColor3 = Theme.Element
    holder.BorderSizePixel = 0
    holder.ZIndex = 13
    holder.Parent = page
    addCorner(holder, 10)
    addStroke(holder, Theme.Border, 1)

    local label = makeLabel(
        holder,
        labelText,
        UDim2.fromOffset(250, 22),
        UDim2.fromOffset(14, 8),
        12,
        Theme.Text,
        Enum.Font.GothamSemibold
    )
    label.ZIndex = 14

    local desc = makeLabel(
        holder,
        description,
        UDim2.fromOffset(330, 18),
        UDim2.fromOffset(14, 29),
        9,
        Theme.Muted,
        Enum.Font.GothamMedium
    )
    desc.ZIndex = 14

    local value = makeLabel(
        holder,
        "",
        UDim2.fromOffset(100, 22),
        UDim2.new(1, -114, 0, 8),
        12,
        Theme.Accent2,
        Enum.Font.GothamBold
    )
    value.TextXAlignment = Enum.TextXAlignment.Right
    value.ZIndex = 14

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -28, 0, 8)
    bar.Position = UDim2.fromOffset(14, 58)
    bar.BackgroundColor3 = Color3.fromRGB(43, 46, 57)
    bar.BorderSizePixel = 0
    bar.ZIndex = 14
    bar.Parent = holder
    addCorner(bar, 6)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = Theme.Accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 15
    fill.Parent = bar
    addCorner(fill, 6)

    local dragging = false
    local places = decimals or 2

    local function formatValue(number)
        return string.format("%." .. places .. "f", number)
    end

    local function applyFromX(x)
        local alpha = math.clamp(
            (x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
            0,
            1
        )

        local number = minValue + (maxValue - minValue) * alpha
        setter(number)

        fill.Size = UDim2.fromScale(alpha, 1)
        value.Text = formatValue(number) .. (suffix or "")
    end

    local function refresh()
        local number = getter()
        local alpha = math.clamp(
            (number - minValue) / (maxValue - minValue),
            0,
            1
        )

        fill.Size = UDim2.fromScale(alpha, 1)
        value.Text = formatValue(number) .. (suffix or "")
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            applyFromX(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            applyFromX(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    refresh()
    return refresh
end


