local function refreshConfigSlots()
    for i = 1, 3 do
        if configs[i] then
            slotButtons[i].Text = "CONFIG " .. i .. "\nSAVED"
            slotButtons[i].TextColor3 = Theme.Success
        else
            slotButtons[i].Text = "CONFIG " .. i .. "\nEMPTY"
            slotButtons[i].TextColor3 = Theme.Muted
        end

        if currentConfig == i then
            slotButtons[i].BackgroundColor3 = Theme.AccentDark
        else
            slotButtons[i].BackgroundColor3 = Theme.Element
        end
    end
end

for i = 1, 3 do
    slotButtons[i].MouseButton1Click:Connect(function()
        currentConfig = i
        savePersistentData()
        refreshConfigSlots()

        if configs[i] then
            setConfigStatus("Selected CONFIG " .. i .. " • Saved preset available", true)
        else
            setConfigStatus("Selected CONFIG " .. i .. " • Empty slot", false)
        end
    end)
end

save.MouseButton1Click:Connect(function()
    saveConfig(currentConfig)
    refreshConfigSlots()
    setConfigStatus("Saved current settings to CONFIG " .. currentConfig, true)
end)

load.MouseButton1Click:Connect(function()
    if loadConfig(currentConfig) then
        for _, refresh in ipairs(refreshAim) do
            refresh()
        end
        for _, refresh in ipairs(refreshTrigger) do
            refresh()
        end

        refreshConfigSlots()
        setConfigStatus("Loaded CONFIG " .. currentConfig, true)
    else
        setConfigStatus("CONFIG " .. currentConfig .. " is empty", false)
    end
end)

reset.MouseButton1Click:Connect(function()
    resetSettings()

    for _, refresh in ipairs(refreshAim) do
        refresh()
    end
    for _, refresh in ipairs(refreshTrigger) do
        refresh()
    end

    savePersistentData()
    setConfigStatus("Restored default settings", true)
end)


local function selectPage(name)
    for pageName, page in pairs(pages) do
        page.Visible = (pageName == name)
    end

    for buttonName, parts in pairs(tabButtons) do
        local active = (buttonName == name)

        parts.Indicator.Visible = active
        parts.Text.TextColor3 = active and Theme.Text or Theme.Muted
        parts.Icon.TextColor3 = active and Theme.Accent2 or Theme.Muted

        tween(parts.Button, tweenFast, {
            BackgroundColor3 = active and Theme.ElementHover or Theme.Element
        }):Play()
    end
end

aimTab.MouseButton1Click:Connect(function()
    selectPage("Aim")
end)

triggerTab.MouseButton1Click:Connect(function()
    selectPage("Triggerbot")
end)

configTab.MouseButton1Click:Connect(function()
    selectPage("Config")
end)

infoTab.MouseButton1Click:Connect(function()
    selectPage("Info")
end)

selectPage("Aim")
refreshConfigSlots()


local dragging = false
local dragStart
local startPosition

top.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart

        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)


local isOpen = false

local function openMenu()
    if isOpen then
        return
    end

    isOpen = true
    gui.Enabled = true

    mainScale.Scale = settings.MenuAnimation and 0.94 or 1
    overlay.BackgroundTransparency = settings.MenuAnimation and 1 or 0.35

    if settings.MenuAnimation then
        tween(overlay, tweenNormal, {
            BackgroundTransparency = 0.35
        }):Play()

        tween(mainScale, tweenNormal, {
            Scale = 1
        }):Play()
    end
end

local function closeMenu()
    if not isOpen then
        return
    end

    isOpen = false

    if settings.MenuAnimation then
        tween(overlay, tweenNormal, {
            BackgroundTransparency = 1
        }):Play()

        local out = tween(mainScale, tweenNormal, {
            Scale = 0.94
        })

        out.Completed:Connect(function()
            if not isOpen then
                gui.Enabled = false
            end
        end)

        out:Play()
    else
        gui.Enabled = false
    end
end

